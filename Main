import{getCharacters,getEpisodes,searchCharacters,searchEpisodes}from'./api.js';import{renderCharacters,renderEpisodes}from'./render.js';const el={form:document.querySelector('#search-form'),input:document.querySelector('#search-input'),box:document.querySelector('#cards-container'),message:document.querySelector('#status-message'),title:document.querySelector('#results-title'),toggle:document.querySelector('#show-episodes')};let characters=[],episodes=[],type='characters';const list=x=>Array.isArray(x)?x:x.results??[];function message(text='',error=false){el.message.textContent=text;el.message.hidden=!text;el.message.classList.toggle('error',error)}function show(kind,data,title){type=kind;el.title.textContent=title;el.toggle.textContent=kind==='characters'?'Ver episodios':'Ver personajes';kind==='characters'?renderCharacters(el.box,data):renderEpisodes(el.box,data)}async function load(){message('Cargando datos de Springfield…');try{[characters,episodes]=await Promise.all([getCharacters(),getEpisodes()]).then(([a,b])=>[list(a),list(b)]);show('characters',characters,'Personajes destacados');message()}catch(e){message(e.message,true)}}el.form.addEventListener('submit',async e=>{e.preventDefault();const q=el.input.value.trim(),kind=new FormData(el.form).get('type'),data=kind==='characters'?characters:episodes;if(!q)return show(kind,data,kind==='characters'?'Personajes destacados':'Episodios destacados');const result=kind==='characters'?await searchCharacters(q,characters):await searchEpisodes(q,episodes);show(kind,result,`Resultados para “${q}”`);message(result.length?'':`No encontramos resultados para “${q}”.`)});el.toggle.addEventListener('click',()=>{const next=type==='characters'?'episodes':'characters';document.querySelector(`input[value="${next}"]`).checked=true;el.input.value='';show(next,next==='characters'?characters:episodes,next==='characters'?'Personajes destacados':'Episodios destacados');message()});load();
